# Leave everything empty to run fully offline (deterministic demo mode).
# --- Option A: Anthropic API ---
ANTHROPIC_API_KEY=
# --- Option B: any OpenAI-compatible endpoint (LiteLLM proxy, OpenRouter, local) ---
# Set both to route all LLM calls here instead of Anthropic.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# "live" uses an LLM for phrasing, analysis and summaries; "mock" never calls an API.
ENVOY_MODE=
# For Anthropic use claude-* ids; for an OpenAI-compatible proxy use its model ids.
ENVOY_MODEL_SMART=claude-sonnet-5-5
ENVOY_MODEL_FAST=claude-haiku-5-5
# Seconds between pipeline steps, so the UI is watchable on stage. Use 0 for tests.
ENVOY_PACE=0.7
# Optional: raises GitHub API rate limits for repo ingestion
GITHUB_TOKEN=
